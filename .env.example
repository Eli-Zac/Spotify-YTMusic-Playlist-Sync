# Generate with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# Spotify: create an app at https://developer.spotify.com/dashboard
# Add SPOTIFY_REDIRECT_URI below as a Redirect URI on that app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback

# YT Music: create OAuth client (type "TVs and Limited Input devices") at
# https://console.cloud.google.com/apis/credentials, with the YouTube Data API v3 enabled.
YTMUSIC_OAUTH_CLIENT_ID=
YTMUSIC_OAUTH_CLIENT_SECRET=

# Public URL this instance is reachable at (used for links/redirects only)
PUBLIC_BASE_URL=http://localhost:8000
